{
  // kiln — one Worker, one engine container, one deploy.
  // Workers Builds runs `npx wrangler deploy` on every push to main;
  // wrangler builds engine/Dockerfile and pushes it to the integrated
  // registry as part of the same deploy.
  "name": "kiln",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "containers": [
    {
      "class_name": "KilnEngine",
      "image": "./engine/Dockerfile",
      // Two dedicated build containers plus one health/measurement utility.
      "max_instances": 3,
      // "basic" (1 GiB) has proven sufficient for real cadquery/OCCT
      // builds (P1-P4); revisit only if a build OOMs.
      "instance_type": "basic"
    }
  ],
  "workflows": [
    {
      "name": "kiln-build",
      "binding": "BUILD_WORKFLOW",
      "class_name": "KilnBuildWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ENGINE", "class_name": "KilnEngine" },
      { "name": "MCP_OBJECT", "class_name": "KilnMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KilnEngine"] },
    { "tag": "v2", "new_sqlite_classes": ["KilnMcp"] }
  ],

  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "kiln-artifacts" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiln",
      "database_id": "364479db-4a8d-4125-9485-e093d279c580",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
