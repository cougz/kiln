{
  "name": "kiln",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Agentic parametric-CAD platform on Cloudflare — Workers + Containers + R2 + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "check:worker": "wrangler deploy --dry-run --containers-rollout=none --outdir .wrangler/dry-run",
    "test:worker": "vitest run",
    "test:engine": "python3 -m unittest discover -s engine -p 'test_*.py'",
    "check": "npm run typecheck && npm run test:worker && npm run test:engine",
    "validate": "npm run check && npm run check:worker"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.19.0",
    "jose": "6.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260726.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
